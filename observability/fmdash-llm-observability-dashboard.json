      "pluginVersion": "11.3.1",
      "targets": [
        {
          "expr": "sum(rate(fm24_error_events_total{fm24_llm_feature=~\"$feature\"}[15m])) by (fm24_llm_feature) / (sum(rate(fm24_error_events_total{fm24_llm_feature=~\"$feature\"}[15m])) by (fm24_llm_feature) + sum(rate(fm24_llm_call_duration_seconds_count{fm24_llm_feature=~\"$feature\"}[15m])) by (fm24_llm_feature))",
          "legendFormat": "{{fm24_llm_feature}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "title": "LLM call failure rate, by feature",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
