          "expr": "sum(increase(fm24_llm_call_duration_seconds_count{fm24_llm_feature=~\"$feature\"}[6h])) by (fm24_llm_feature, fm24_llm_round) / on (fm24_llm_feature) group_left sum(increase(fm24_llm_call_duration_seconds_count{fm24_llm_feature=~\"$feature\", fm24_llm_round=\"0\"}[6h])) by (fm24_llm_feature)",
