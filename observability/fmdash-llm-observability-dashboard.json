    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "One data point per Responses API round-trip (includes tool-calling rounds, not just final answers). A spike with no matching business-metric spike usually means more search rounds, not more requests.",
